{
  "name": "stratum-obsidian",
  "version": "0.1.0",
  "description": "Create enriched structured literature notes from your Zotero library.",
  "packageManager": "pnpm@10.12.4",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "node --test --import tsx src/test/*.test.ts",
    "lint": "eslint src manifest.json LICENSE",
    "lint:fix": "eslint src manifest.json LICENSE --fix",
    "lint:review": "OBSIDIAN_REVIEW=1 eslint src manifest.json LICENSE",
    "format": "prettier --write src/"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@eslint/json": "0.14.0",
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.15",
    "dotenv": "17.3.1",
    "esbuild": "0.27.4",
    "eslint": "9.39.4",
    "eslint-plugin-obsidianmd": "0.1.9",
    "globals": "17.4.0",
    "jiti": "2.6.1",
    "obsidian": "1.12.3",
    "prettier": "3.8.1",
    "tslib": "2.8.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.1"
  }
}
