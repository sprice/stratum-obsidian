{
  "name": "stratum-obsidian",
  "version": "0.6.0",
  "description": "Create enriched structured literature notes from your Zotero library.",
  "packageManager": "pnpm@10.12.4",
  "engines": {
    "node": ">=22.18.0"
  },
  "main": "main.js",
  "type": "module",
  "scripts": {
    "test:browser": "node scripts/run-quiet.mjs pnpm run test:browser:verbose",
    "test:browser:verbose": "node --test --import tsx src/test/browser/publishing.test.ts src/test/browser/publication-editor.test.ts",
    "dev": "node esbuild.config.mjs",
    "build": "node scripts/run-quiet.mjs pnpm run build:verbose",
    "build:verbose": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "check": "node scripts/run-quiet.mjs pnpm run check:verbose",
    "check:verbose": "pnpm test:tooling && pnpm format:check && pnpm lint:review && pnpm lint:scorecard && pnpm test && pnpm typecheck && pnpm build",
    "typecheck": "node scripts/run-quiet.mjs pnpm run typecheck:verbose",
    "typecheck:verbose": "tsc --noEmit",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "test": "node scripts/run-quiet.mjs pnpm run test:verbose",
    "test:verbose": "node scripts/require-publishing-tools.mjs && node --test --import tsx src/test/*.test.ts",
    "lint": "node scripts/run-quiet.mjs pnpm run lint:verbose",
    "lint:verbose": "eslint src manifest.json LICENSE",
    "lint:fix": "node scripts/run-quiet.mjs pnpm run lint:fix:verbose",
    "lint:fix:verbose": "eslint src manifest.json LICENSE --fix",
    "lint:review": "node scripts/run-quiet.mjs pnpm run lint:review:verbose",
    "lint:review:verbose": "OBSIDIAN_REVIEW=1 eslint src manifest.json LICENSE --max-warnings=0",
    "lint:scorecard": "node scripts/run-quiet.mjs pnpm run lint:scorecard:verbose",
    "lint:scorecard:verbose": "node scripts/lint-scorecard.mjs && pnpm lint:scorecard:rules",
    "format:check": "node scripts/run-quiet.mjs pnpm run format:check:verbose",
    "format:check:verbose": "prettier --check src/",
    "format": "node scripts/run-quiet.mjs pnpm run format:verbose",
    "format:verbose": "prettier --write src/",
    "test:tooling": "node scripts/run-quiet.mjs pnpm run test:tooling:verbose",
    "test:tooling:verbose": "node --test scripts/run-quiet.test.mjs scripts/ci-test-coverage.test.mjs scripts/require-publishing-tools.test.mjs scripts/scorecard-rules.test.mjs scripts/ci-cache.test.mjs scripts/ci-local-validation.test.mjs",
    "quiet": "node scripts/run-quiet.mjs",
    "test:publishing:preflight": "node scripts/require-publishing-tools.mjs",
    "lint:scorecard:rules": "node scripts/run-quiet.mjs node scripts/scorecard-rules.mjs",
    "ci:prepare": "node scripts/ci-cache-prepare.mjs",
    "ci:format": "wireit",
    "ci:lint-review": "wireit",
    "ci:scorecard": "wireit",
    "ci:test-tooling": "wireit",
    "ci:typecheck": "wireit",
    "ci:test": "wireit",
    "ci:test-browser": "wireit",
    "ci:publishing-preflight": "wireit",
    "ci:build": "wireit",
    "ci:check": "node scripts/ci-check.mjs",
    "ci:validate": "wireit"
  },
  "keywords": [],
  "license": "MIT",
  "devDependencies": {
    "@browserbasehq/stagehand": "4.1.0",
    "@codemirror/state": "6.5.2",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "9.39.5",
    "@eslint/json": "0.14.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-plugin-obsidianmd": "0.4.2",
    "globals": "17.13.0",
    "jiti": "2.7.0",
    "obsidian": "1.13.1",
    "prettier": "3.9.9",
    "tslib": "2.8.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "wireit": "0.14.13",
    "yaml": "2.8.3"
  },
  "pnpm": {
    "overrides": {
      "flatted@<3.4.2": "3.4.2",
      "brace-expansion@1": "1.1.21",
      "brace-expansion@2": "2.1.7",
      "brace-expansion@5": "5.0.12",
      "fast-uri@3": "3.1.8",
      "@humanfs/node@0.16": "0.16.8",
      "moment@<2.31.0": "2.31.0",
      "picomatch@4.0.3": "4.0.7",
      "yaml@2.8.2": "2.8.3"
    }
  },
  "dependencies": {
    "citeproc": "2.4.63",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5"
  },
  "wireit": {
    "ci:inputs": {
      "files": [
        "package.json",
        "pnpm-lock.yaml",
        ".npmrc",
        "pnpm-workspace.yaml",
        ".ci-cache/environment.json",
        ".gitignore",
        "scripts/run-quiet.mjs"
      ],
      "packageLocks": [
        "pnpm-lock.yaml"
      ]
    },
    "ci:format": {
      "command": "pnpm format:check",
      "dependencies": [
        "ci:source-inputs"
      ],
      "files": [
        ".prettier*",
        "prettier.config.*",
        ".editorconfig"
      ],
      "output": [],
      "env": {
        "NODE_OPTIONS": {
          "external": true
        },
        "LANG": {
          "external": true
        },
        "LC_ALL": {
          "external": true
        },
        "TZ": {
          "external": true
        }
      }
    },
    "ci:lint-review": {
      "command": "pnpm lint:review",
      "dependencies": [
        "ci:source-inputs"
      ],
      "files": [
        "eslint.config.*",
        "manifest.json",
        "LICENSE"
      ],
      "output": [],
      "env": {
        "NODE_OPTIONS": {
          "external": true
        },
        "LANG": {
          "external": true
        },
        "LC_ALL": {
          "external": true
        },
        "TZ": {
          "external": true
        }
      }
    },
    "ci:scorecard": {
      "command": "pnpm lint:scorecard",
      "dependencies": [
        "ci:source-inputs"
      ],
      "files": [
        "eslint.config.*",
        "styles.css",
        "scripts/lint-scorecard.mjs",
        "scripts/scorecard-program.mjs",
        "scripts/scorecard-rules.mjs"
      ],
      "output": [],
      "env": {
        "NODE_OPTIONS": {
          "external": true
        },
        "LANG": {
          "external": true
        },
        "LC_ALL": {
          "external": true
        },
        "TZ": {
          "external": true
        }
      }
    },
    "ci:test-tooling": {
      "command": "pnpm test:tooling",
      "dependencies": [
        "ci:inputs"
      ],
      "files": [
        "scripts/**/*",
        ".github/**/*",
        "src/publication-metadata.ts",
        "src/yaml-binary.ts"
      ],
      "output": [],
      "env": {
        "NODE_OPTIONS": {
          "external": true
        },
        "LANG": {
          "external": true
        },
        "LC_ALL": {
          "external": true
        },
        "TZ": {
          "external": true
        }
      }
    },
    "ci:typecheck": {
      "command": "pnpm typecheck",
      "dependencies": [
        "ci:source-inputs"
      ],
      "files": [],
      "output": [],
      "env": {
        "NODE_OPTIONS": {
          "external": true
        },
        "LANG": {
          "external": true
        },
        "LC_ALL": {
          "external": true
        },
        "TZ": {
          "external": true
        }
      }
    },
    "ci:test": {
      "command": "pnpm test",
      "dependencies": [
        "ci:source-inputs"
      ],
      "files": [
        ".ci-cache/publishing.json",
        "scripts/require-publishing-tools.mjs"
      ],
      "output": [],
      "env": {
        "NODE_OPTIONS": {
          "external": true
        },
        "LANG": {
          "external": true
        },
        "LC_ALL": {
          "external": true
        },
        "TZ": {
          "external": true
        },
        "STRATUM_REQUIRE_PUBLISHING_TOOLS": {
          "external": true
        },
        "STRATUM_TEST_PANDOC": {
          "external": true
        },
        "STRATUM_TEST_TECTONIC": {
          "external": true
        },
        "STRATUM_TEST_PDFTOTEXT": {
          "external": true
        },
        "STRATUM_TEST_CHROME": {
          "external": true
        },
        "STRATUM_TEST_TEMPLATE_CACHE": {
          "external": true
        }
      }
    },
    "ci:test-browser": {
      "command": "pnpm test:browser",
      "dependencies": [
        "ci:source-inputs"
      ],
      "files": [
        ".ci-cache/publishing.json",
        "styles.css"
      ],
      "output": [
        ".test-artifacts/publishing/*.png",
        ".test-artifacts/publishing/timings.json"
      ],
      "env": {
        "NODE_OPTIONS": {
          "external": true
        },
        "LANG": {
          "external": true
        },
        "LC_ALL": {
          "external": true
        },
        "TZ": {
          "external": true
        },
        "STRATUM_REQUIRE_PUBLISHING_TOOLS": {
          "external": true
        },
        "STRATUM_TEST_PANDOC": {
          "external": true
        },
        "STRATUM_TEST_TECTONIC": {
          "external": true
        },
        "STRATUM_TEST_PDFTOTEXT": {
          "external": true
        },
        "STRATUM_TEST_CHROME": {
          "external": true
        },
        "STRATUM_TEST_TEMPLATE_CACHE": {
          "external": true
        }
      }
    },
    "ci:publishing-preflight": {
      "command": "pnpm test:publishing:preflight",
      "dependencies": [
        "ci:inputs"
      ],
      "files": [
        ".ci-cache/publishing.json",
        "scripts/require-publishing-tools.mjs"
      ],
      "output": [
        ".test-artifacts/publishing/tools.json"
      ],
      "env": {
        "NODE_OPTIONS": {
          "external": true
        },
        "LANG": {
          "external": true
        },
        "LC_ALL": {
          "external": true
        },
        "TZ": {
          "external": true
        },
        "STRATUM_REQUIRE_PUBLISHING_TOOLS": {
          "external": true
        },
        "STRATUM_TEST_PANDOC": {
          "external": true
        },
        "STRATUM_TEST_TECTONIC": {
          "external": true
        },
        "STRATUM_TEST_PDFTOTEXT": {
          "external": true
        },
        "STRATUM_TEST_CHROME": {
          "external": true
        },
        "STRATUM_TEST_TEMPLATE_CACHE": {
          "external": true
        }
      }
    },
    "ci:build": {
      "command": "node scripts/run-quiet.mjs node esbuild.config.mjs production",
      "dependencies": [
        "ci:source-inputs"
      ],
      "files": [
        "esbuild.config.mjs",
        "plugin.config.json",
        ".env",
        "THIRD_PARTY_NOTICES.md",
        "licenses/**/*",
        "scripts/scorecard-bundle.mjs",
        "scripts/scorecard-rules.mjs"
      ],
      "output": [
        "main.js"
      ],
      "env": {
        "NODE_OPTIONS": {
          "external": true
        },
        "LANG": {
          "external": true
        },
        "LC_ALL": {
          "external": true
        },
        "TZ": {
          "external": true
        },
        "STRATUM_WEB_APP_URL": {
          "external": true
        },
        "STRATUM_TEMPLATE_REGISTRY_ORIGIN": {
          "external": true
        },
        "STRATUM_SUPABASE_URL": {
          "external": true
        },
        "STRATUM_SUPABASE_PUBLISHABLE_KEY": {
          "external": true
        },
        "STRATUM_DEBUG": {
          "external": true
        }
      }
    },
    "ci:source-inputs": {
      "dependencies": [
        "ci:inputs"
      ],
      "files": [
        "src/**/*",
        "tsconfig*.json"
      ]
    },
    "ci:validate": {
      "dependencies": [
        "ci:test",
        "ci:test-tooling",
        "ci:publishing-preflight",
        "ci:format",
        "ci:lint-review",
        "ci:scorecard",
        "ci:test-browser",
        "ci:typecheck",
        "ci:build"
      ]
    }
  }
}
