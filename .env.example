# Optional: Override backend URLs for development.
# Without a .env file, the build uses the committed production config.
# Contributors can build and run tests without any .env configuration.

# STRATUM_WEB_APP_URL=https://stratumnotes.com
# Cloud requests default to STRATUM_WEB_APP_URL/api/stratum.
# Optional direct backend override for self-hosting:
# STRATUM_SUPABASE_URL=http://127.0.0.1:50321
# STRATUM_SUPABASE_PUBLISHABLE_KEY=
STRATUM_DEBUG=true
